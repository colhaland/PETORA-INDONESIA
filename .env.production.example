APP_NAME=PETORA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://petora.example.com
APP_DOMAIN=petora.example.com
ACME_EMAIL=
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

IMAGE_REPOSITORY=ghcr.io/colhaland/petora-indonesia
IMAGE_TAG=

POSTGRES_DB=petora
POSTGRES_USER=petora
POSTGRES_PASSWORD=
POSTGRES_CA_CERT=/etc/petora/secrets/postgres-ca.crt
POSTGRES_SERVER_CERT=/etc/petora/secrets/postgres-server.crt
POSTGRES_SERVER_KEY=/etc/petora/secrets/postgres-server.key
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=petora
DB_USERNAME=petora
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/secrets/postgres-ca.crt

REDIS_PASSWORD=
REDIS_URL=rediss://redis:6379/0
REDIS_CACHE_URL=rediss://redis:6379/1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_SCHEME=tls
REDIS_SSL_CA_CERT=/etc/petora/secrets/redis-ca.crt
REDIS_SSL_SERVER_CERT=/etc/petora/secrets/redis-server.crt
REDIS_SSL_SERVER_KEY=/etc/petora/secrets/redis-server.key
REDIS_SSL_CA=/run/secrets/redis-ca.crt
HEALTHCHECK_TOKEN=

BACKUP_ENCRYPTION_KEY_FILE=/etc/petora/secrets/backup-encryption-key
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PETORA

BACKUP_RETENTION_DAYS=35
